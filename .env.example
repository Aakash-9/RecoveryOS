# ---------------------------------------------------------------------------
# RecoveryOS environment
# Copy to .env and fill in. Everything below is optional: with LLM_ENABLED=false
# the entire system runs deterministically and offline.
# ---------------------------------------------------------------------------

# --- LLM (optional; narration / extraction / message drafting only) ---------
# The LLM is architecturally forbidden from the money path. Turning it off
# changes prose only -- every decision and every rupee figure is identical.
LLM_ENABLED=false

# OpenAI-compatible endpoint. Works with Hugging Face Inference Providers,
# Groq, OpenRouter, Together, or a local Ollama -- no code change.
#   Hugging Face : https://router.huggingface.co/v1
#   Ollama local : http://localhost:11434/v1
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b:fastest
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=700

# Responses are cached on disk by prompt hash so the demo never depends on the
# network and a reviewer can reproduce it without a token.
LLM_CACHE_DIR=data/llm_cache
LLM_CACHE_ONLY=false

# --- Storage ----------------------------------------------------------------
RECOVERYOS_DB=data/recoveryos.db

# --- Determinism ------------------------------------------------------------
RECOVERYOS_SEED=42

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8001
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8001
